  "metrics": {
    "SALES_AMOUNT": {
      "aliases": ["매출", "매출액", "주문금액"],
      "source_field": "SALES_AMOUNT",
      "source_binding": {"dataset_family": "sales_actual", "field": "SALES_AMOUNT"},
      "aggregation": "sum",
      "additivity": {"default": "fully_additive", "allowed_rollups": ["sum", "mean", "min", "max"]},
      "unit": "KRW"
    },
    "REFUND_AMOUNT": {
      "aliases": ["환불", "환불액", "환불금액"],
      "source_field": "REFUND_AMOUNT",
      "source_binding": {"dataset_family": "sales_refund", "field": "REFUND_AMOUNT"},
      "aggregation": "sum",
      "additivity": {"default": "fully_additive", "allowed_rollups": ["sum", "mean", "min", "max"]},
      "unit": "KRW"
    },
    "TARGET_AMOUNT": {
      "aliases": ["목표", "매출목표", "목표금액", "목표액"],
      "source_field": "TARGET_AMOUNT",
      "source_binding": {"dataset_family": "sales_target", "field": "TARGET_AMOUNT"},
      "aggregation": "sum",
      "additivity": {"default": "fully_additive", "allowed_rollups": ["sum", "min", "max"]},
      "unit": "KRW"
    },
    "NET_SALES_AMOUNT": {
      "aliases": ["순매출", "순매출액"],
      "aggregation": "sum",
      "additivity": {"default": "fully_additive", "allowed_rollups": ["sum"]},
      "formula": {"op": "subtract", "left_metric": "SALES_AMOUNT", "right_metric": "REFUND_AMOUNT"},
      "unit": "KRW"
    },
    "ACHIEVEMENT_RATE": {
      "aliases": ["달성률", "목표 달성률"],
      "aggregation": "ratio_after_aggregate",
      "additivity": {"default": "non_additive", "allowed_rollups": ["mean"]},
      "formula": {"op": "safe_divide", "numerator_metric": "SALES_AMOUNT", "denominator_metric": "TARGET_AMOUNT"},
      "unit": "percent"
    }
  },
  "entity_groups": {
    "all_products": {
      "aliases": ["전체 상품", "모든 상품"],
      "entity": "PRODUCT_ID",
      "selection": {"operator": "all_registered"}
    },
    "electronics_category": {
      "aliases": ["전자 카테고리", "전자 상품군"],
      "target_field": "CATEGORY",
      "selection": {"operator": "eq", "value": "A", "semantic_type": "string"}
    },
    "living_category": {
      "aliases": ["생활 카테고리", "생활 상품군"],
      "target_field": "CATEGORY",
      "selection": {"operator": "eq", "value": "B", "semantic_type": "string"}
    }
  },
  "grains": {
    "product": {"keys": ["PRODUCT_ID"], "display_fields": ["PRODUCT_NAME", "CATEGORY"]},
    "customer": {"keys": ["CUSTOMER_ID"]},
    "order": {"keys": ["ORDER_ID"]},
    "date_product": {"keys": ["TARGET_DATE", "PRODUCT_ID"]}
  },
  "relations": {
    "orders_products": {
      "left_dataset": "orders",
      "right_dataset": "products",
      "left_keys": ["PRODUCT_ID"],
      "right_keys": ["PRODUCT_ID"],
      "join_type": "left",
      "cardinality": "many_to_one",
      "null_key_policy": "never_match",
      "multi_match_policy": "fail"
    },
    "orders_refunds": {
      "left_dataset": "orders",
      "right_dataset": "refunds",
      "left_keys": ["ORDER_ID", "PRODUCT_ID"],
      "right_keys": ["ORDER_ID", "PRODUCT_ID"],
      "join_type": "left",
      "cardinality": "one_to_zero_or_one",
      "null_key_policy": "never_match",
      "multi_match_policy": "fail"
    },
    "sales_targets": {
      "left_dataset": "orders",
      "right_dataset": "targets",
      "left_keys": ["PRODUCT_ID"],
      "right_keys": ["PRODUCT_ID"],
      "join_type": "left",
      "cardinality": "many_to_one",
      "null_key_policy": "never_match",
      "multi_match_policy": "fail"
    }
  },
  "orderings": {
    "product_name": {"keys": [{"field": "PRODUCT_NAME", "direction": "asc", "nulls": "last"}]},
    "sales_desc": {"keys": [{"field": "SALES_AMOUNT", "direction": "desc", "nulls": "last"}]}
  },
  "predicates": {},
  "recipes": {
    "sales.summary": {
      "aliases": ["총 매출", "매출 합계", "전체 매출"],
      "required_slots": ["date_scope"],
      "default_operation_template": {"op": "aggregate", "metrics": ["SALES_AMOUNT"], "group_by": []}
    },
    "sales.by_product": {
      "aliases": ["상품별 매출", "제품별 매출"],
      "required_slots": ["date_scope"],
      "default_operation_template": {
        "op": "join",
        "relation_id": "orders_products",
        "next": {"op": "aggregate", "metrics": ["SALES_AMOUNT"], "group_by": ["PRODUCT_ID", "PRODUCT_NAME", "CATEGORY"]}
      }
    },
    "sales.rank": {
      "aliases": ["매출 상위", "매출 하위", "가장 큰 매출", "가장 작은 매출"],
      "required_slots": ["date_scope", "rank_direction", "rank_limit"],
      "default_operation_template": {
        "op": "rank",
        "metric": "SALES_AMOUNT",
        "grain_id": "product",
        "include_ties": true,
        "stable_tie_break": ["PRODUCT_ID"]
      }
    },
    "sales.net_by_product": {
      "aliases": ["상품별 순매출", "환불 제외 매출"],
      "required_slots": ["date_scope"],
      "default_operation_template": {
        "op": "join",
        "relation_id": "orders_refunds",
        "next": {"op": "aggregate", "metrics": ["SALES_AMOUNT", "REFUND_AMOUNT", "NET_SALES_AMOUNT"], "group_by": ["PRODUCT_ID"]}
      }
    },
    "sales.target_comparison": {
      "aliases": ["목표 대비 매출", "달성률"],
      "required_slots": ["date_scope"],
      "default_operation_template": {
        "op": "join",
        "relation_id": "sales_targets",
        "next": {
          "op": "derive",
          "metric": "ACHIEVEMENT_RATE",
          "next": {"op": "project", "fields": ["PRODUCT_ID", "ACHIEVEMENT_RATE"]}
        }
      }
    },
    "sales.detail_projection": {
      "aliases": ["주문 상세", "주문 컬럼만 보여줘"],
      "required_slots": ["project_fields"],
      "default_operation_template": {"op": "project", "allowed_fields": ["ORDER_ID", "ORDER_DATE", "CUSTOMER_ID", "PRODUCT_ID", "SALES_AMOUNT"]}
    }
  },
  "aliases": {
    "dataset:orders": {"target_type": "dataset", "target_key": "orders", "values": ["주문", "판매", "매출 데이터"]},
    "dataset:products": {"target_type": "dataset", "target_key": "products", "values": ["상품", "제품 마스터"]},
    "dataset:refunds": {"target_type": "dataset", "target_key": "refunds", "values": ["환불", "반품"]},
