# 실제 값은 v5의 .env에서 복사하며, 이 예시 파일이나 Flow JSON에는 비밀값을 저장하지 않습니다.
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.5-flash-lite
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=90
GEMINI_API_KEY=
GOOGLE_API_KEY=

MONGODB_URI=
MONGODB_DATABASE=datagov
MONGODB_VALIDATION_DATABASE=datagov_v6_validation
MONGODB_V6_DOMAIN_COLLECTION=agent_v6_domain_metadata
MONGODB_V6_TABLE_COLLECTION=agent_v6_table_catalog
MONGODB_V6_MAIN_FILTER_COLLECTION=agent_v6_main_filter
MONGODB_V6_RESULT_COLLECTION=agent_v6_result_store
MONGODB_V6_SESSION_COLLECTION=agent_v6_session_state

RUN_LLM_VALIDATION=false
RUN_MONGODB_VALIDATION=false
