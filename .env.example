# 실제 값은 v5의 .env에서 복사하며, 이 예시 파일이나 Flow JSON에는 비밀값을 저장하지 않습니다.
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.5-flash-lite
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=90
GEMINI_API_KEY=
GOOGLE_API_KEY=

MONGODB_URI=
MONGODB_DATABASE=datagov
MONGODB_V6_SEMANTIC_COLLECTION=agent_v6_semantic_catalog
MONGODB_V6_DATASET_COLLECTION=agent_v6_dataset_catalog
MONGODB_V6_FILTER_COLLECTION=agent_v6_filter_catalog
MONGODB_V6_PENDING_COLLECTION=agent_v6_pending_writes
MONGODB_V6_AUDIT_COLLECTION=agent_v6_authoring_audit
MONGODB_V6_RESULT_COLLECTION=agent_v6_result_store
MONGODB_V6_SESSION_COLLECTION=agent_v6_session_state

AGENT_DEFAULT_DATE=20260730
AGENT_TIMEZONE=Asia/Seoul
RUN_LLM_VALIDATION=false
RUN_MONGODB_VALIDATION=false
