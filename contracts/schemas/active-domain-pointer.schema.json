{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metadata-driven-v6.local/schemas/active-domain-pointer.schema.json",
  "title": "metadata.active-domain-pointer.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "domain_id",
    "environment",
    "revision",
    "bundle_sha256",
    "package_sha256",
    "status"
  ],
  "properties": {
    "contract_version": {
      "const": "metadata.active-domain-pointer.v1"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "active"
    }
  }
}
