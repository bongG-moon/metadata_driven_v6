{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metadata-driven-v6.local/schemas/runtime-catalog-v2.schema.json",
  "title": "metadata.runtime.catalog.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "domain_id",
    "environment",
    "revision",
    "compiler_version",
    "display_name",
    "locale",
    "timezone",
    "datasets",
    "fields",
    "metrics",
    "entity_groups",
    "grains",
    "relations",
    "orderings",
    "predicates",
    "recipes",
    "aliases",
    "prompt_extensions",
    "specialized_functions",
    "output_profile",
    "catalog_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "metadata.runtime.catalog.v2"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {"^.{1,256}$": {"$ref": "#/$defs/jsonObject"}},
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {"^.{1,256}$": {"$ref": "#/$defs/jsonObject"}},
      "additionalProperties": false
    },
    "metrics": {
      "$ref": "#/$defs/jsonObject"
    },
    "entity_groups": {
      "$ref": "#/$defs/jsonObject"
    },
    "grains": {
      "$ref": "#/$defs/jsonObject"
    },
    "relations": {
      "$ref": "#/$defs/jsonObject"
    },
    "orderings": {
      "$ref": "#/$defs/jsonObject"
    },
    "predicates": {
      "$ref": "#/$defs/jsonObject"
    },
    "recipes": {
      "$ref": "#/$defs/jsonObject"
    },
    "aliases": {
      "$ref": "#/$defs/jsonObject"
    },
    "prompt_extensions": {
      "$ref": "#/$defs/jsonObject"
    },
    "specialized_functions": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/specializedFunction"}
    },
    "output_profile": {
      "$ref": "#/$defs/jsonObject"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "specializedFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_id",
        "version",
        "execution_mode",
        "implementation_sha256",
        "input_schema",
        "output_schema"
      ],
      "properties": {
        "function_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {"type": "integer", "minimum": 1},
        "execution_mode": {"const": "registered_standalone"},
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_schema": {"$ref": "#/$defs/jsonObject"},
        "output_schema": {"$ref": "#/$defs/jsonObject"},
        "required_fields": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "limits": {"$ref": "#/$defs/registeredFunctionLimits"},
        "failure_policy": {"const": "fail_closed"},
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "call_template": {"$ref": "#/$defs/registeredFunctionCallTemplate"}
      }
    },
    "registeredFunctionLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_input_rows", "max_output_rows", "max_output_bytes"],
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 5000},
        "max_input_rows": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_output_rows": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}
      }
    },
    "registeredFunctionCallTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_ref", "field_ref", "parameters", "output_fields"],
      "properties": {
        "dataset_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "field_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens", "operator", "match_mode", "case_sensitive"],
          "properties": {
            "tokens": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "operator": {"enum": ["equals", "contains", "starts_with", "ends_with"]},
            "match_mode": {"enum": ["any", "all"]},
            "case_sensitive": {"type": "boolean"}
          }
        },
        "output_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "jsonObject": {
      "type": "object",
      "patternProperties": {"^.{1,256}$": {"$ref": "#/$defs/jsonValue"}},
      "additionalProperties": false
    },
    "jsonValue": {
      "anyOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/jsonValue"}},
        {"$ref": "#/$defs/jsonObject"}
      ]
    }
  }
}
