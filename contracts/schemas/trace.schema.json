{
  "$defs": {
    "jsonObject": {
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_.:/-]{0,127}$": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "properties": {},
      "required": [],
      "type": "object"
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/jsonValue"
          },
          "maxItems": 2048,
          "type": "array"
        },
        {
          "$ref": "#/$defs/jsonObject"
        }
      ]
    }
  },
  "$id": "https://metadata-driven-v6.local/schemas/trace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "trace.v1",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/jsonObject"
      },
      "maxItems": 128,
      "type": "array"
    },
    "trace_id": {
      "minLength": 1,
      "type": "string"
    },
    "verbose_trace_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{1,31}:[A-Za-z0-9._:-]{4,256}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "trace_id",
    "events",
    "verbose_trace_ref"
  ],
  "title": "trace.v1",
  "type": "object"
}
