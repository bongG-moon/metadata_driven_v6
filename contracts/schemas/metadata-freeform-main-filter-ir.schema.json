{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metadata-driven.local/contracts/metadata-freeform-main-filter-ir.schema.json",
  "title": "Natural-language Main Filter Item IR v1",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {"$ref": "#/$defs/filterItem"}
    }
  },
  "$defs": {
    "filterItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filter_key", "payload"],
      "properties": {
        "filter_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aliases"],
          "properties": {
            "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
            "aliases": {
              "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "column_candidates": {
              "type": "array", "maxItems": 64, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "semantic_role": {"type": "string", "maxLength": 64},
            "value_type": {"type": "string", "maxLength": 64},
            "value_shape": {"type": "string", "maxLength": 64},
            "operator": {"type": "string", "maxLength": 64}
          }
        }
      }
    }
  }
}
