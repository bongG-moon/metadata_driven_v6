{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metadata-driven.local/contracts/metadata-freeform-domain-ir.schema.json",
  "title": "Natural-language Domain Item IR v1",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "key", "payload"],
      "properties": {
        "section": {
          "enum": ["profile", "entity_groups", "metrics", "grains", "relations", "orderings", "predicates", "recipes"]
        },
        "key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "payload": {"$ref": "#/$defs/jsonObject"}
      }
    },
    "jsonObject": {
      "type": "object",
      "maxProperties": 128,
      "patternProperties": {"^.{1,256}$": {"$ref": "#/$defs/jsonValue"}},
      "additionalProperties": false
    },
    "jsonValue": {
      "oneOf": [
        {"type": "string", "maxLength": 65536},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/jsonValue"}},
        {"$ref": "#/$defs/jsonObject"}
      ]
    }
  }
}
